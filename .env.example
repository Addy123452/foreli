# ============================================================
# Foreli environment variables (placeholders only — never commit secrets)
# ============================================================

# ---------- Backend (SERVER-SIDE ONLY — never expose to the browser) ----------
# Comma-separated browser origins allowed to call the API with cookies.
# Leave unset for local development (same origin).
# For production set your deployed frontend origin, e.g.:
# FORELI_CORS_ORIGINS=https://your-foreli.vercel.app
FORELI_CORS_ORIGINS=

# Set to 1 when the backend is served over HTTPS (secure HttpOnly cookies).
FORELI_COOKIE_SECURE=0

# Optional: override the SQLite database file path (e.g. a mounted volume).
# FORELI_DB_PATH=/data/foreli.db

# ---------- Frontend (PUBLIC, browser-side) ----------
# Static sites have no runtime env vars. Configure the backend origin in
# assets/js/config.js before deploying the frontend:
#   window.FORELI_API_BASE = "https://your-foreli-api.example.com";
# Leave it empty when the backend serves the frontend from the same origin.
